{
	"plugins": [
		"stylelint-order",
		"./plugins/stylelint-plugin-hover-media.js",
		"./plugins/stylelint-plugin-flex-column.js",
		"./plugins/stylelint-plugin-no-hardcoded-color.js",
		"./plugins/stylelint-plugin-no-primitive-token.js",
		"./plugins/stylelint-plugin-no-root-tag-selector.js",
		"./plugins/stylelint-plugin-border-width.js",
		"./plugins/stylelint-plugin-container.js",
		"./plugins/stylelint-plugin-is-grouping.js",
		"./plugins/stylelint-plugin-media-width.js",
		"./plugins/stylelint-plugin-modifier-context.js",
		"./plugins/stylelint-plugin-nesting-context.js",
		"./plugins/stylelint-plugin-pseudo-class-nesting.js",
		"./plugins/stylelint-plugin-pseudo-element-nesting.js",
		"./plugins/stylelint-plugin-tag-nesting.js",
		"./plugins/stylelint-plugin-logical-properties.js"
	],
	"rules": {
		"order/properties-order": [
			[
				"inline-size",
				"min-inline-size",
				"max-inline-size",
				"width",
				"min-width",
				"max-width",
				"block-size",
				"min-block-size",
				"max-block-size",
				"height",
				"min-height",
				"max-height",
				"aspect-ratio",
				"align-self",
				"justify-self",
				"place-self",

				"display",
				"grid",
				"grid-template",
				"grid-template-columns",
				"grid-template-rows",
				"grid-template-areas",
				"grid-area",
				"grid-column",
				"grid-row",
				"flex",
				"flex-direction",
				"flex-wrap",
				"flex-shrink",
				"flex-grow",
				"flex-basis",
				"align-items",
				"align-content",
				"justify-items",
				"justify-content",
				"place-items",
				"place-content",
				"gap",
				"row-gap",
				"column-gap",

				"position",
				"inset",
				"inset-block",
				"inset-inline",
				"inset-block-start",
				"inset-block-end",
				"inset-inline-start",
				"inset-inline-end",
				"top",
				"right",
				"bottom",
				"left",
				"z-index",

				"margin",
				"margin-block",
				"margin-inline",
				"margin-block-start",
				"margin-block-end",
				"margin-inline-start",
				"margin-inline-end",
				"padding",
				"padding-block",
				"padding-inline",
				"padding-block-start",
				"padding-block-end",
				"padding-inline-start",
				"padding-inline-end",

				"overflow",
				"overflow-x",
				"overflow-y",
				"overflow-block",
				"overflow-inline",
				"visibility",
				"opacity",

				"font",
				"font-family",
				"font-size",
				"font-weight",
				"font-style",
				"font-variant",
				"line-height",
				"letter-spacing",
				"text-align",
				"text-transform",
				"text-decoration",
				"text-overflow",
				"white-space",
				"word-break",
				"color",

				"background-color",
				"background-image",
				"background-size",
				"background-position",
				"background-repeat",
				"background-clip",
				"background-origin",
				"border",
				"border-width",
				"border-style",
				"border-color",
				"border-radius",
				"border-block",
				"border-block-start",
				"border-block-end",
				"border-inline",
				"border-inline-start",
				"border-inline-end",
				"border-top",
				"border-right",
				"border-bottom",
				"border-left",
				"outline",
				"outline-color",
				"outline-offset",
				"box-shadow",
				"filter",
				"backdrop-filter",
				"isolation",
				"will-change",
				"transform",
				"rotate",
				"translate",
				"scale",
				"transition",
				"animation",
				"cursor",
				"pointer-events",
				"user-select",
				"content",
				"counter-reset",
				"counter-increment"
			],
			{
				"unspecified": "bottom",
				"severity": "warning"
			}
		],

		"local/hover-requires-media": true,
		"local/no-flex-column": true,
		"local/no-hardcoded-color": true,
		"local/no-primitive-token": true,
		"local/no-root-tag-selector": true,
		"local/border-width-min": true,
		"local/container-requires-nesting": true,
		"local/use-is-grouping": true,
		"local/media-width-requires-nesting": true,
		"local/modifier-context-requires-nesting": true,
		"local/nesting-context": true,
		"local/pseudo-class-requires-nesting": true,
		"local/pseudo-element-requires-nesting": true,
		"local/tag-selector-requires-nesting": true,
		"local/logical-properties": true,

		"declaration-property-value-allowed-list": {
			"background": ["none"]
		},
		"property-disallowed-list": [
			"margin-left",
			"margin-right",
			"margin-top",
			"margin-bottom",
			"padding-left",
			"padding-right",
			"padding-top",
			"padding-bottom"
		],
		"color-function-notation": "modern",
		"max-nesting-depth": [
			1,
			{
				"ignore": ["blockless-at-rules", "pseudo-classes"],
				"ignoreAtRules": ["media", "container", "supports", "layer", "property", "starting-style"]
			}
		],
		"no-duplicate-selectors": true,
		"block-no-empty": true,
		"no-unknown-animations": true,
		"shorthand-property-no-redundant-values": true,
		"declaration-block-no-duplicate-properties": true,
		"unit-no-unknown": true,
		"color-no-invalid-hex": true,
		"media-feature-range-notation": "context"
	},
	"overrides": [
		{
			"files": ["**/base/*.css"],
			"rules": {
				"local/no-root-tag-selector": null
			}
		}
	]
}
