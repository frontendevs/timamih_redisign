{
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint --config oxlint.json .",
		"lint:css": "stylelint \"pages/**/*.css\"",
		"lint:css:fix": "stylelint \"pages/**/*.css\" --fix",
		"lint:css:dead": "vite-node plugins/find-dead-css.ts",
		"lint:html": "htmlhint \"pages/**/*.html\"",
		"audit:baseline": "vite-node plugins/audit-baseline.ts",
		"typecheck": "tsc --noEmit",
		"check": "npm run lint && npm run lint:css && npm run lint:html",
		"check:fix": "npm run format && npm run lint:css:fix",
		"images:optimize": "vite-node plugins/optimize-images.ts",
		"images:products": "vite-node plugins/generate-product-sizes.ts"
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"@vitejs/plugin-vue": "^6.0.7",
		"htmlhint": "latest",
		"oxfmt": "latest",
		"oxlint": "latest",
		"sharp": "^0.34.5",
		"stylelint": "^17.12.0",
		"stylelint-order": "^8.1.1",
		"vite": "^8.0.16",
		"vite-node": "^6.0.0",
		"vue": "^3.5.38",
		"web-features": "^3.29.0"
	}
}
